<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network for AI backend calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phone calls (only fired after explicit in-app user confirmation) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS (only sent after explicit in-app user confirmation) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Calendar events -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Alarms -->
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Foreground service so voice listening can continue with the screen on / notification visible.
         NOTE: Android does NOT allow a normal app to record audio or run arbitrary code while
         the device is actually locked (screen off + keyguard shown), or to draw its UI over
         the lock screen the way a system assistant can. This service keeps Jarvis alive while
         the screen is ON (e.g. lock screen showing but not passcode-locked, or foreground use). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shows the activity on top of the lock screen (before a PIN/pattern/biometric is entered),
         which is the officially supported mechanism for lock-screen presence. It does NOT bypass
         the actual unlock security. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jarvis"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Optional: lets Jarvis respond to the system "Assist" long-press/gesture
                 if the user sets it as their default assistant app in Android Settings. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.JarvisForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

    </application>
</manifest>
