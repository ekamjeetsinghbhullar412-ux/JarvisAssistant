# Copy this file to .env and fill in real values. Never commit the real .env file.

# Your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# A long random string you generate yourself, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match JARVIS_DEVICE_TOKEN passed to the Android build.
JARVIS_DEVICE_TOKEN=replace-with-a-long-random-string

PORT=3000
